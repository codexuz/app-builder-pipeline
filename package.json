{
  "name": "app-pipeline",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Turns one request into a real small or medium app: Nuxt UI web, Ionic mobile, Supabase backend.",
  "workspaces": [
    "packages/*",
    "apps/*/shared",
    "apps/*/web",
    "apps/*/mobile"
  ],
  "scripts": {
    "pipeline": "tsx packages/pipeline/cli.ts",
    "validate": "tsx packages/pipeline/cli.ts validate",
    "new": "tsx packages/pipeline/cli.ts new",
    "generate": "tsx packages/pipeline/cli.ts generate",
    "verify": "tsx packages/pipeline/cli.ts verify",
    "lock": "tsx packages/pipeline/cli.ts lock",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "for s in specs/examples/*.yaml; do tsx packages/pipeline/cli.ts verify-db $s || exit 1; done"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
