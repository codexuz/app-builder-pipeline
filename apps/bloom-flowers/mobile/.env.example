# Same Supabase project as the web app. Values are baked into the native build.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
# The deployed web app (Vercel). Confirmation, password-reset and invite links open there.
NUXT_PUBLIC_WEB_URL=https://your-app.vercel.app
